{
  "schema_version": 1,
  "protocol": "clean_room",
  "description": "Fast synthetic multi-seed coverage for the first five assigned methods.",
  "seeds": [0, 1, 2, 3, 4],
  "data": {
    "n_positive": 120,
    "n_unlabeled": 480,
    "n_train": 600,
    "n_test": 500,
    "n_features": 8,
    "class_prior": 0.3,
    "separation": 2.0,
    "label_frequency": 0.4,
    "sar_strength": 1.25,
    "sar_mechanism": "linear"
  },
  "methods": {
    "class_prior_estimation": {
      "variant": "clean_room_penl1",
      "parameters": {
        "sigma": 1.0,
        "reg_lambda": 0.01,
        "n_centers": 120,
        "standardize": true
      }
    },
    "recpe": {
      "variant": "clean_room_logistic_default_cpe",
      "parameters": {
        "copy_fraction": 0.1,
        "classifier_max_iter": 1000
      }
    },
    "dist_pu": {
      "variant": "clean_room_full_batch_mlp",
      "parameters": {
        "hidden_dim": 32,
        "epochs": 25,
        "batch_size": 128,
        "learning_rate": 0.001,
        "alignment_weight": 1.0,
        "entropy_weight": 0.05,
        "mixup_weight": 0.1,
        "device": "cpu"
      }
    },
    "pusb": {
      "variant": "clean_room_source_logistic",
      "parameters": {
        "threshold": 0.5,
        "C": 1.0,
        "max_iter": 1000
      }
    },
    "lbe": {
      "variant": "clean_room_linear_em",
      "parameters": {
        "max_iter": 1000,
        "n_em_iter": 20,
        "C": 1.0
      }
    }
  },
  "limitations": [
    "Synthetic data only.",
    "No result in this configuration is an official paper reproduction.",
    "Dist-PU uses the toolbox full-batch MLP rather than the official image backbones.",
    "PUSB uses the toolbox source-classification baseline rather than the official kernel objective.",
    "LBE uses linear alternating logistic models rather than the official MLP and Adam implementation."
  ]
}
